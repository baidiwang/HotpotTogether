# Server runtime only. Never prefix these with VITE_. No real secrets in this file.
HOTPOT_AI_ENABLED=false
# Lovable manages this project credential. Its stored value is write-only.
# Leave blank locally unless a runtime credential has been legitimately provisioned.
LOVABLE_API_KEY=
# Set to a model ID available to your Lovable project that supports Chat Completions
# with strict json_schema structured output. No model is silently selected.
HOTPOT_AI_MODEL=google/gemini-3.8-flash

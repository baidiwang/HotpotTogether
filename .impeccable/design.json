      "html": "<button class=\"ds-seat\" aria-label=\"Edit Casey's preference\"><span class=\"ds-person\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z\"/><path d=\"M2 22c0-6 6-12 12-14\"/></svg></span><span class=\"ds-name\">Casey</span><span class=\"ds-diet\">Vegetarian</span></button>",
      "css": ".ds-seat{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:flex;flex-direction:column;align-items:center;width:104px;padding:0;background:transparent;border:0;text-align:center;color:var(--pt-ink,#30332e);cursor:pointer}.ds-person{display:grid;place-items:center;width:36px;height:36px;border:1px solid #b7c8ac;border-radius:50%;background:#e8eee1;color:var(--pt-leaf,#376744)}.ds-person svg{width:17px;height:17px;stroke-width:1.5}.ds-name{font-size:12px;font-weight:500;margin-top:4px}.ds-diet{font-size:11px;line-height:1.4;color:var(--pt-leaf,#376744)}.ds-seat:hover{background:transparent}.ds-seat:focus-visible{outline:2px solid var(--pt-tomato,#b94431);outline-offset:4px;}@media(max-width:760px){.ds-seat{width:76px}.ds-person{width:30px;height:30px}.ds-diet{font-size:10px}}"

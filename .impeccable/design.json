    {
      "name": "Use These Changes",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Accept the remaining valid suggested changes as one action.",
      "html": "<button class=\"ds-primary\">Use these changes <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 5v14m-6-6 6 6 6-6\"/></svg></button>",
      "css": ".ds-primary{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;background:var(--pt-tomato,#a94e39);color:#fffefa;border:0;border-radius:6px;padding:10px 14px;min-height:40px;font-size:13px;cursor:pointer;white-space:nowrap}.ds-primary svg{width:15px;height:15px}.ds-primary:hover{background:var(--pt-tomato,#a94e39)}.ds-primary:focus-visible{outline:2px solid #a94e39;outline-offset:4px;}.ds-primary:disabled{opacity:.42;cursor:not-allowed}"
    },
    {
      "name": "Plate Quantity Controls",
      "kind": "button",
      "refersTo": "button-quantity",
      "description": "The revealed minus, plus and Must keep action bar; no artwork is substituted in this preview.",
      "html": "<div class=\"ds-controls\" aria-label=\"Edit Silken tofu\"><button aria-label=\"Remove one plate of Silken tofu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14\"/></svg></button><button aria-label=\"Add one plate of Silken tofu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button><button class=\"ds-kept\" aria-label=\"Unmark Silken tofu must keep\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m16 9 3-3-1-1-3 3-5-2-4 4 3 3-5 7 7-5 3 3 4-4-2-5Z\"/></svg></button></div>",
      "css": ".ds-controls{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:inline-flex;gap:4px;padding:4px;border-radius:9px;background:#fcfcfaf5;box-shadow:0 4px 14px #5a463315}.ds-controls button{display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:50%;background:transparent;color:var(--pt-ink,#34362f);cursor:pointer}.ds-controls button:hover,.ds-controls .ds-kept{color:var(--pt-leaf,#486c45);background:#e8eddf}.ds-controls button:focus-visible{outline:2px solid #a94e39;outline-offset:4px;}.ds-controls button:disabled{opacity:.42;cursor:not-allowed}.ds-controls svg{width:16px;height:16px}"
    },
    {
      "name": "Persistent Must Keep Pin",
      "kind": "chip",
      "refersTo": "kept-marker",
      "description": "This marker stays on a protected plate when its action bar closes.",
      "html": "<span class=\"ds-pin\" title=\"Must keep: assistants retain at least 2 plates.\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m16 9 3-3-1-1-3 3-5-2-4 4 3 3-5 7 7-5 3 3 4-4-2-5Z\"/></svg><span class=\"ds-sr\">Must keep 2+</span></span>",
      "css": ".ds-pin{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:grid;place-items:center;width:24px;height:24px;border-radius:50%;color:var(--pt-leaf,#486c45);background:#eef1e7}.ds-pin svg{width:14px;height:14px}.ds-sr{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}"
    },
    {
      "name": "Budget Field",
      "kind": "input",
      "refersTo": "budget-field",
      "description": "The existing labeled native number input inside its compact popover.",
      "html": "<div class=\"ds-budget-field\"><label for=\"ds-budget\">Budget for the table ($)</label><input id=\"ds-budget\" type=\"number\" min=\"0\" max=\"10000\" value=\"120\"/><p>Purchase costs update as you place food.</p></div>",
      "css": ".ds-budget-field{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);width:214px;max-width:100%;color:#30332e;font-size:14px}.ds-budget-field input{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:block;width:100%;padding:8px;margin-top:8px;border:1px solid #dfe2d9;border-radius:4px;color:#30332e;background:#fcfcfa;font-size:14px;box-sizing:border-box}.ds-budget-field input:focus-visible{outline:2px solid #a94e39;outline-offset:4px;}.ds-budget-field p{font-size:12px;color:#63675f;margin:10px 0 0}"
    },
    {
      "name": "Table Toolbar",
      "kind": "nav",
      "refersTo": "toolbar",
      "description": "The quiet Sample mode, Undo, Reset and Shopping list tools.",
      "html": "<nav class=\"ds-tools\" aria-label=\"Table tools\"><button class=\"ds-mode\">Sample mode <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button><button aria-label=\"Undo\" disabled><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M3 10h11a7 7 0 0 1 7 7M3 10l5-5m-5 5 5 5\"/></svg></button><button>Reset</button><button class=\"ds-shopping\">Shopping list</button></nav>",
      "css": ".ds-tools{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:flex;align-items:center;gap:16px;flex-wrap:wrap;color:var(--pt-ink,#34362f);background:var(--pt-paper,#fcfcfa);min-height:70px}.ds-tools button{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:4px 6px;background:transparent;border:0;color:inherit;font-size:13px;cursor:pointer;white-space:nowrap}.ds-tools .ds-mode{font-size:12px;color:var(--pt-muted,#686c60)}.ds-tools svg{width:17px;height:17px}.ds-tools .ds-mode svg{width:12px}.ds-tools .ds-shopping{border-left:1px solid var(--pt-line,#e4e3db);padding-left:20px}.ds-tools button:hover{background:transparent}.ds-tools button:focus-visible{outline:2px solid #a94e39;outline-offset:4px;}.ds-tools button:disabled{opacity:.42;cursor:not-allowed}"
    },
    {
      "name": "Preference Popover",
      "kind": "card",
      "refersTo": "preference-popover",
      "description": "The compact floating preference container with explicit selected words and check.",
      "html": "<section class=\"ds-preference\" aria-label=\"Casey’s preference\"><strong>A seat for Casey</strong><button aria-pressed=\"false\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21v-2a8 8 0 0 1 16 0v2\"/></svg>Eats everything</button><button aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11 20A8 8 0 0 1 9 4c5 0 8-2 8-2 1 2 3 4 3 8a10 10 0 0 1-9 10ZM2 22l10-10\"/></svg>Vegetarian <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></button><button class=\"ds-remove\">Remove friend</button></section>",
      "css": ".ds-preference{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);width:250px;max-width:calc(100vw - 24px);padding:18px;box-sizing:border-box;background:#fcfcfa;color:#30332e;border:1px solid #dfe2d9;border-radius:6px;box-shadow:0 4px 6px -1px #0000001a,0 2px 4px -2px #0000001a;font-size:14px}.ds-preference>strong{display:block;margin-bottom:10px;font-weight:500}.ds-preference button{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:flex;align-items:center;gap:7px;width:100%;min-height:42px;padding:0;background:transparent;border:0;color:inherit;font-size:14px;text-align:left;cursor:pointer}.ds-preference button[aria-pressed=\"true\"]{color:#376744}.ds-preference svg{width:15px;height:15px;flex-shrink:0}.ds-preference button svg:last-child:not(:first-child){margin-left:auto}.ds-preference .ds-remove{margin-top:8px;border-top:1px solid #dfe2d9;padding-top:10px;color:#914332}.ds-preference button:hover{background:transparent}.ds-preference button:focus-visible{outline:2px solid #a94e39;outline-offset:4px;}"
    },
    {
      "name": "Current to Proposed Quantity",
      "kind": "custom",
      "refersTo": "suggestion-strip",
      "description": "An optional food change with independent Use, Reject and Why controls.",
      "html": "<div class=\"ds-offer\"><button class=\"ds-use\" aria-label=\"Accept Silken tofu suggestion\"><span class=\"ds-count\">2 → 3 plates</span><span class=\"ds-use-label\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg>Use</span></button><button class=\"ds-reject\" aria-label=\"Reject Silken tofu suggestion\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 6 12 12M6 18 18 6\"/></svg></button><button class=\"ds-why\" aria-label=\"Why change Silken tofu\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6m0-10v1\"/></svg></button></div>",
      "css": ".ds-offer{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:2px;min-height:32px;color:var(--pt-leaf,#486c45)}.ds-offer button{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);border:0;color:inherit;cursor:pointer;background:transparent;font-size:12px}.ds-offer .ds-use{display:flex;align-items:center;gap:5px;min-height:32px;padding:3px 5px;background:#edf0e6d9;border-radius:5px}.ds-count{white-space:nowrap;font-variant-numeric:tabular-nums}.ds-use-label{display:inline-flex;align-items:center;gap:2px;font-weight:500}.ds-use-label svg{width:13px;height:13px}.ds-reject,.ds-why{display:grid;place-items:center;width:28px;height:32px;padding:5px;flex-shrink:0}.ds-reject svg,.ds-why svg{width:14px;height:14px}.ds-reject:hover,.ds-why:hover{background:#ede9df;border-radius:50%}.ds-use:hover{background:#edf0e6d9}.ds-offer button:focus-visible{outline:2px solid #a94e39;outline-offset:4px;}"
    },

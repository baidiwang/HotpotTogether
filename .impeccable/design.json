      "css": ".ds-place-setting{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);width:148px;text-align:center;color:var(--pt-ink,#30332e)}.ds-porcelain{position:relative;width:116px;height:66px;margin:0 auto 5px;border:1px solid #e4e4db;border-radius:50%;background:#fffefa;box-shadow:0 5px 9px #38442a09}.ds-porcelain:after{content:\"\";position:absolute;inset:5px 7px;border:1px solid #eeeee6;border-radius:50%;pointer-events:none}.ds-place-setting strong{display:block;font-size:12px;line-height:1.4;font-weight:500}.ds-place-setting>span{display:block;font-size:11px;line-height:1.4;color:var(--pt-muted,#63675f)}@media(max-width:760px){.ds-place-setting{width:100%}.ds-porcelain{width:80px;height:48px}.ds-place-setting strong{font-size:11px}.ds-place-setting>span{font-size:10px}}"
    },
    {
      "name": "Pending Plate",
      "kind": "custom",
      "refersTo": "ghost-plate",
      "description": "UI-only pending material specimen; production reuses translucent PNG food at opacity 0.43 inside this wrapper.",
      "html": "<button class=\"ds-pending\" aria-label=\"Accept tofu suggestion\"><span class=\"ds-pending-art\"></span><span class=\"ds-pending-label\">+1 suggested</span></button>",
      "css": ".ds-pending{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:flex;flex-direction:column;align-items:center;width:74px;padding:0;border:0;background:transparent;color:var(--pt-leaf,#376744);cursor:pointer}.ds-pending-art{display:grid;place-items:center;width:64px;height:42px;border:1px dashed #64825b;border-radius:50%;background:#f5f8eea6;transform:rotate(6deg)}.ds-pending-label{padding:3px 4px;background:#fcfcfaeb;border-radius:3px;white-space:nowrap;font-size:10px}.ds-pending:hover{background:transparent}.ds-pending:focus-visible{outline:2px solid var(--pt-tomato,#b94431);outline-offset:4px;}@media(prefers-reduced-motion:no-preference){.ds-pending{animation:ds-arrive 240ms cubic-bezier(.16,1,.3,1)}@keyframes ds-arrive{from{opacity:.3;filter:blur(2px)}to{opacity:1;filter:blur(0)}}@media(max-width:760px){.ds-pending{width:65px}.ds-pending-art{width:58px;height:39px}.ds-pending-label{font-size:8px}}"
    },
    {
      "name": "Expandable Purchase Row",
      "kind": "custom",
      "refersTo": "purchase-row",
      "description": "UI-only disclosure specimen showing the implemented type, hairline and portion-to-package detail; raster thumbnail omitted.",
      "html": "<details class=\"ds-purchase\"><summary><span><strong>Beef rolls</strong><small>3 plates</small></span><span>$48 <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span></summary><div class=\"ds-package\"><p>One plate = 300 g.</p><p>Planned 900 g → buy 3 × 300 g.</p><p>900 g purchased · 0 g surplus.</p><p>3 × $16 = $48.</p></div></details>",
      "css": ".ds-purchase{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);max-width:404px;border-bottom:1px solid var(--pt-line,#dfe2d9);background:var(--pt-paper,#fcfcfa);color:var(--pt-ink,#30332e)}.ds-purchase summary{display:flex;gap:14px;align-items:center;min-height:92px;list-style:none;cursor:pointer}.ds-purchase summary::-webkit-details-marker{display:none}.ds-purchase summary>span:first-child{flex:1}.ds-purchase strong{display:block;font-size:13px;font-weight:500}.ds-purchase small{display:block;margin-top:3px;font-size:11px;color:var(--pt-muted,#63675f)}.ds-purchase summary>span:last-child{display:flex;align-items:center;gap:9px;font-size:12px}.ds-purchase summary:hover{background:transparent}.ds-purchase summary:focus-visible{outline:2px solid var(--pt-tomato,#b94431);outline-offset:4px;}.ds-package{padding:0 0 14px 0;color:var(--pt-muted,#63675f);font-size:12px}.ds-package p{margin:4px 0;line-height:1.6}"
    }
  ],
  "narrative": {
    "northStar": "A Quiet Place-Setting Ritual",
    "overview": "The built playable table makes dinner planning feel like arranging a shared meal: soft food cutouts sit on pale porcelain, friends have named seats, and controls stay beside the object they change. Space, restrained Instrument Sans and a light paper ground carry the hierarchy. Tomato marks the main acceptance action; leaf green carries dietary and protected-food meaning.\n\nThe user's NONO MARKET references establish generous white space, soft food texture and reserved typography. Their commerce composition is not a layout template. The previous form, role tabs and review card are the confirmed visual anti-reference for this replacement. This document records the implemented playable surface; the surface contract retains its particular composition and interaction story.",
    "keyCharacteristics": [
      "Object-adjacent controls and short English labels.",
      "Solid selected food and translucent, explicitly optional suggestions.",
      "Quiet boundaries, pale material layers and restrained color.",
      "One reused type family and unchanged repository food artwork."
    ],
    "rules": [
      {
        "name": "The Meaningful Accent Rule",
        "body": "Use Tomato for commitment and Leaf for dietary, protected and suggested states; retain text or an icon so color is never the only signal.",
        "section": "colors"
      },
      {
        "name": "The Quiet Hierarchy Rule",
        "body": "Build hierarchy with size, spacing and regular-to-medium weight; keep labels in natural sentence case and keep the interface English.",
        "section": "typography"
      },
      {
        "name": "The Material Depth Rule",
        "body": "Give food and porcelain a soft contact cue; keep separators and empty space responsible for interface grouping.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep controls beside the friend, plate or pot they change.",
      "Do preserve the distinction between solid selected food and translucent unaccepted suggestions.",
      "Do reuse Instrument Sans and the existing food cutouts.",
      "Do pair dietary, protected and suggestion color with explicit words or SVG icons.",
      "Do preserve visible focus, keyboard/click alternatives to dragging, and the mobile friends strip.",
      "Do derive portions, package costs and assistant explanations from the shared calculations."
    ],
    "donts": [
      "Don't restore the previous form, role-tab and review-card composition as the table's template.",
      "Don't treat NONO MARKET's commerce layout as the application's layout template.",
      "Don't present an unaccepted plate or preview cost as part of the confirmed table.",
      "Don't describe deterministic Shopping or Budget calculations as separate model calls.",
      "Don't imply Live is configured locally or silently switch a failed Live request to Sample.",
      "Don't add game timers, levels, character movement, checkout or invented stock."
    ]
  }
}

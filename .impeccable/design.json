      "name": "Place Together",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Accept all remaining valid suggestions; source keeps the hover state quiet.",
      "html": "<button class=\"ds-primary\">Place together <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14m-7-7 7 7 7-7\"/></svg></button>",
      "css": ".ds-primary{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:inline-flex;align-items:center;gap:8px;min-height:38px;padding:8px 12px;font-size:12px;font-weight:400;background:var(--pt-tomato,#b94431);color:#fff;border:0;border-radius:6px;cursor:pointer}.ds-primary:hover{background:var(--pt-tomato,#b94431)}.ds-primary:focus-visible{outline:2px solid var(--pt-tomato,#b94431);outline-offset:4px;}.ds-primary:disabled{opacity:.4;cursor:not-allowed}"
    },
    {
      "name": "Plate Quantity Action",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Small circular, object-adjacent quantity control; mobile grows to 30px square.",
      "html": "<button class=\"ds-quantity\" aria-label=\"Add one plate of Napa cabbage\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-quantity{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);width:27px;height:26px;display:grid;place-items:center;padding:0;background:transparent;color:var(--pt-ink,#30332e);border:0;border-radius:50%;cursor:pointer}.ds-quantity:hover{background:#e2e7d9}.ds-quantity:focus-visible{outline:2px solid var(--pt-tomato,#b94431);outline-offset:4px;}.ds-quantity:active{cursor:pointer}.ds-quantity:disabled{opacity:.4;cursor:not-allowed}@media(max-width:760px){.ds-quantity{width:30px;height:30px}}"
    },
    {
      "name": "Budget Field",
      "kind": "input",
      "refersTo": "budget-field",
      "description": "Visible label with the existing inset, border and browser-native input focus.",
      "html": "<label class=\"ds-budget-label\" for=\"ds-budget-input\">Budget for the table ($)<input class=\"ds-budget-input\" id=\"ds-budget-input\" type=\"number\" min=\"0\" max=\"10000\" value=\"120\"></label>",
      "css": ".ds-budget-label{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:block;max-width:214px;color:var(--pt-ink,#30332e);font-size:14px}.ds-budget-input{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:block;width:100%;margin-top:8px;padding:8px;border:1px solid var(--pt-line,#dfe2d9);border-radius:4px;color:var(--pt-ink,#30332e);caret-color:var(--pt-tomato,#b94431);font-size:14px}.ds-budget-input:hover{border-color:var(--pt-line,#dfe2d9)}.ds-budget-input:focus-visible{outline:auto}"
    },
    {
      "name": "Table Tool Row",
      "kind": "nav",
      "refersTo": "toolbar",
      "description": "Plain compact actions with a divider before Shopping list; no navigation-card styling.",
      "html": "<div class=\"ds-tools\"><button class=\"ds-mode\">Sample mode <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button><button>Reset</button><button class=\"ds-shopping\">Shopping list</button></div>",
      "css": ".ds-tools{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:flex;align-items:center;justify-content:flex-end;gap:16px;min-height:76px;border-bottom:1px solid var(--pt-line,#dfe2d9);color:var(--pt-ink,#30332e);background:var(--pt-paper,#fcfcfa)}.ds-tools button{font-family:var(--font-sans,\"Instrument Sans\",system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:4px 6px;border:0;background:transparent;color:inherit;font-size:14px;cursor:pointer}.ds-tools .ds-mode{font-size:12px;color:var(--pt-muted,#63675f)}.ds-tools .ds-shopping{border-left:1px solid var(--pt-line,#dfe2d9);padding-left:18px}.ds-tools button:hover{background:transparent}.ds-tools button:focus-visible{outline:2px solid var(--pt-tomato,#b94431);outline-offset:4px;}@media(max-width:760px){.ds-tools{gap:8px;flex-wrap:wrap}.ds-tools .ds-mode{margin-right:auto}.ds-tools button,.ds-tools .ds-mode{font-size:11px}}"
    },
